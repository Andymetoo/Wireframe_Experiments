  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Back onto ice with S; hold C for chase view. Lower the conditioner, run
    both augers and start near 0.35 mm. Open wash, prime 10 seconds, then start pickup.


    Follow
    the previous wet edge with the outer tire. Hover the survey for exact cells;
    F2 shows treatment. Pickup recovers liquid; deep grooves need more cutting.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
